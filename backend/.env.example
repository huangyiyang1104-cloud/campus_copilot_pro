# 数据库（异步驱动必须用 mysql+aiomysql）
DATABASE_URL=mysql+aiomysql://root:your_password@127.0.0.1:3306/campus_agent?charset=utf8mb4

# Redis（本地开发可走 SSH 隧道，端口填隧道本地端口）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT 密钥（生产环境请重新生成，例如：openssl rand -hex 32）
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256

# AT 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=15

# RT 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# 大模型 API Key（后续接入时填写）
DEEPSEEK_APIKEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_APIKEY=

# 阿里云 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# Milvus：本地 Lite 用文件路径；云上 Standalone 改成 http://ip:19530
MILVUS_ENDPOINT=./data/milvus_lite.db
MILVUS_COLLECTION=course_material_chunks

# 资料处理：auto 时本地 Lite 自动用 inline，远程 Milvus 用 celery
MATERIAL_TASK_MODE=auto

# Embedding（DashScope OpenAI 兼容接口）
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024

# MinerU 文档解析（PDF/Word/PPT/Excel -> Markdown）
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
